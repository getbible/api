# Copy to .env next to compose.yaml; no repository clone is needed on the server.
# Nonempty GETBIBLE_* application settings override values saved by the menu.
# Empty optional values leave the saved setting/default in control.
GETBIBLE_IMAGE_REPOSITORY=ghcr.io/getbible/api
GETBIBLE_IMAGE_TAG=3.0.3
GETBIBLE_DATA_ROOT=/srv/getbible-data
GETBIBLE_HOSTNAME=getbible
TZ=UTC

# Generic example limits; size these for your deployment.
# Limits are ceilings, not preallocated memory or dedicated CPU cores.
# Bind to the Docker host's LAN address in production, reachable by HAProxy.
GETBIBLE_BIND_ADDRESS=0.0.0.0
GETBIBLE_HTTP_PORT=8080
GETBIBLE_MEMORY_LIMIT=4g
GETBIBLE_CPU_LIMIT=2.0
GETBIBLE_PIDS_LIMIT=4096
GETBIBLE_SHM_SIZE=64m
GETBIBLE_STOP_GRACE_PERIOD=120s

# HAProxy terminates TLS. Trust its actual LAN source IP/CIDR, never all IPs.
GETBIBLE_TLS_MODE=external
GETBIBLE_TRUSTED_PROXY_CIDRS=
GETBIBLE_PUBLIC_SCHEME=https
GETBIBLE_ORIGIN_HTTP_PORT=80
GETBIBLE_DEFAULT_DEPLOY_MODE=staged
GETBIBLE_DEFAULT_ACCESS_MODE=metered
GETBIBLE_DEFAULT_RATE_PER_SECOND=50
GETBIBLE_DEFAULT_RATE_BURST=250
GETBIBLE_DEFAULT_QUOTA_HOUR=10000
GETBIBLE_DEFAULT_QUOTA_DAY=100000
GETBIBLE_DEFAULT_CONN_LIMIT=100
GETBIBLE_DEFAULT_CACHE_TTL=2592000
GETBIBLE_DEFAULT_SHA_CACHE_TTL=300
GETBIBLE_DEFAULT_QUERY_CACHE_TTL=2592000
GETBIBLE_DEFAULT_SEARCH_CACHE_TTL=2592000
GETBIBLE_DEFAULT_QUERY_WORKERS=auto
GETBIBLE_DEFAULT_QUERY_THREADS=4
GETBIBLE_DEFAULT_SEARCH_WORKERS=auto
GETBIBLE_DEFAULT_SEARCH_THREADS=4
# Optional application budget lower than the hard Docker limit; empty=auto.
GETBIBLE_MEMORY_BUDGET=auto
GETBIBLE_DEFAULT_SYNC_SCHEDULE=monthly
GETBIBLE_DEFAULT_EXTENSIONS=
GETBIBLE_LOG_ROTATE_SIZE=1G
GETBIBLE_LOG_ROTATE_KEEP=30
GETBIBLE_HSTS_INCLUDE_SUBDOMAINS=

# GitHub registry credentials belong in host `docker login`, not in this file.
# Cloudflare token is a separate API credential used for domain configuration.
GETBIBLE_CLOUDFLARE_ENABLED=true
GETBIBLE_DEFAULT_CLOUDFLARE_MODE=proxied
GETBIBLE_DEFAULT_CLOUDFLARE_CACHE=respect
GETBIBLE_DEFAULT_CLOUDFLARE_FEATURES=free
GETBIBLE_CLOUDFLARE_API_TOKEN=
GETBIBLE_CLOUDFLARE_API_TOKEN_FILE=
# Explicit firewall WAN origin addresses. IPv6="none" removes this host's AAAA
# record; empty IPv6 leaves existing records unchanged.
GETBIBLE_SERVER_PUBLIC_IPV4=
GETBIBLE_SERVER_PUBLIC_IPV6=

GETBIBLE_TELEGRAM_ENABLED=
GETBIBLE_TELEGRAM_BOT_TOKEN=
GETBIBLE_TELEGRAM_BOT_TOKEN_FILE=
GETBIBLE_TELEGRAM_CHAT_ID=
GETBIBLE_TELEGRAM_HOSTNAME=getbible

# Used only if local certificate management is selected instead of external.
GETBIBLE_CERTBOT_EMAIL=
GETBIBLE_CERT_METHOD=

# Runtime memory retention (seconds) and bounded resource allocation
GETBIBLE_MEMORY_CACHE_TTL=2592000
GETBIBLE_CACHE_TTL_JITTER=0
GETBIBLE_QUERY_MEMORY_MIN=192M
GETBIBLE_SEARCH_MEMORY_MIN=512M
GETBIBLE_QUERY_MEMORY_MAX=auto
GETBIBLE_SEARCH_MEMORY_MAX=auto
GETBIBLE_RESOURCE_RESERVE_PERCENT=25
GETBIBLE_QUERY_CPU_QUOTA=auto
GETBIBLE_SEARCH_CPU_QUOTA=auto
GETBIBLE_QUERY_WORKERS_MIN=1
GETBIBLE_QUERY_WORKERS_MAX=12
GETBIBLE_SEARCH_WORKERS_MIN=1
GETBIBLE_SEARCH_WORKERS_MAX=12
GETBIBLE_QUERY_THREADS_MIN=1
GETBIBLE_QUERY_THREADS_MAX=16
GETBIBLE_SEARCH_THREADS_MIN=1
GETBIBLE_SEARCH_THREADS_MAX=8
# Comma-separated codes; none disables startup warming. Lazy warming remains active.
GETBIBLE_QUERY_WARM_TRANSLATIONS=kjv
GETBIBLE_SEARCH_WARM_TRANSLATIONS=kjv
GETBIBLE_CACHE_MEMORY_PERCENT=50
GETBIBLE_SHARED_CORPUS_LIMIT=256
GETBIBLE_CHAPTER_CACHE_LIMIT=100000
GETBIBLE_TRANSLATION_CACHE_LIMIT=256
GETBIBLE_REFERENCE_CACHE_LIMIT=50000

# Adaptive control: sustained demand, safe bounds and a cooldown between changes
GETBIBLE_ADAPTIVE_RESOURCES=true
GETBIBLE_ADAPTIVE_INTERVAL=15
GETBIBLE_ADAPTIVE_COOLDOWN=300
GETBIBLE_ADAPTIVE_HIGH_PERCENT=80
GETBIBLE_ADAPTIVE_LOW_PERCENT=20
GETBIBLE_ADAPTIVE_SUSTAINED_SAMPLES=4

# Canonical traffic history: prune oldest first when age OR size is exceeded
GETBIBLE_TELEMETRY_MAX_GIB=10
GETBIBLE_TELEMETRY_RETENTION_DAYS=180
GETBIBLE_TELEMETRY_BATCH_SIZE=1000
GETBIBLE_TELEMETRY_FLUSH_SECONDS=1
GETBIBLE_TELEMETRY_METRICS_SECONDS=5
# Schema-upgrade time budgets in seconds (1..86400); defaults are 900 each.
# Increase for large retained histories or slow backup storage.
# GETBIBLE_TELEMETRY_BACKUP_SECONDS=900
# GETBIBLE_TELEMETRY_MIGRATION_SECONDS=900

# Private dashboard: enable explicitly through the CLI after configuring Telegram
GETBIBLE_DASHBOARD_DOMAIN=
# Leave empty for CLI control (built-in default is false).
GETBIBLE_DASHBOARD_ENABLED=
GETBIBLE_DASHBOARD_SESSION_DAYS=30
GETBIBLE_DASHBOARD_IDLE_SECONDS=60
GETBIBLE_DASHBOARD_TOKEN_SECONDS=60

# Optional managed-data admission budget in GiB; 0 disables. Not a filesystem quota.
GETBIBLE_STORAGE_MAX_GIB=0

# Bounded transport spools and continuous alert thresholds
GETBIBLE_TELEMETRY_SPOOL_MAX_GIB=1
GETBIBLE_TELEMETRY_SPOOL_ROTATE_MIB=16
GETBIBLE_ALERT_COOLDOWN_SECONDS=900
GETBIBLE_ALERT_HOLD_SECONDS=60
GETBIBLE_ALERT_CPU_PERCENT=95
GETBIBLE_ALERT_MEMORY_PERCENT=90
GETBIBLE_ALERT_DISK_PERCENT=90
GETBIBLE_ALERT_MEMORY_PRESSURE_PERCENT=10

# Preserve warm memory during idle time; alert when scheduled checks are late.
GETBIBLE_ADAPTIVE_ALLOW_IDLE_SHRINK=false
GETBIBLE_ALERT_SYNC_GRACE_SECONDS=3600
