# Private dashboard. Nginx passes only its validated client address; application
# authentication protects every report and action. No shared caching or API
# request-log format is used here: authentication credentials are never logged.
{{#UNLESS EXTERNAL_TLS}}server {
    listen {{HTTP_PORT}};
    server_name {{DOMAIN}};
    include snippets/getbible/acme.conf;
    location / { return 301 https://$host$request_uri; }
}
{{/UNLESS}}server {
{{#IF EXTERNAL_TLS}}    listen {{HTTP_PORT}};
    include snippets/getbible/external-proxy.conf;
{{/IF}}{{#UNLESS EXTERNAL_TLS}}    listen 443 ssl;
    ssl_certificate {{CERT_DIR}}/fullchain.pem;
    ssl_certificate_key {{CERT_DIR}}/privkey.pem;
    include snippets/getbible/tls.conf;
{{/UNLESS}}    server_name {{DOMAIN}};
{{#IF REAL_IP}}    include {{NGINX_GB}}/cloudflare-real-ip.conf;
{{/IF}}    server_tokens off;
    absolute_redirect off;
    access_log off;
    error_log {{LOG}}/dashboard/error.log warn;
    client_max_body_size 2m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    include snippets/getbible/acme.conf;
    include snippets/getbible/origin-probe.conf;
    error_page 400 414 431 = @dashboard_bad_request;
    error_page 413 = @dashboard_too_large;
    error_page 500 502 503 504 = @dashboard_unavailable;
    location @dashboard_bad_request {
        internal;
        default_type application/problem+json;
        add_header Cache-Control "private, no-store" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        return 400 '{"type":"about:blank","title":"Bad Request","status":400,"detail":"The dashboard request is malformed."}';
    }
    location @dashboard_too_large {
        internal;
        default_type application/problem+json;
        add_header Cache-Control "private, no-store" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        return 413 '{"type":"about:blank","title":"Payload Too Large","status":413,"detail":"The dashboard request exceeds the permitted size."}';
    }
    location @dashboard_unavailable {
        internal;
        default_type application/problem+json;
        add_header Cache-Control "private, no-store" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        return 503 '{"type":"about:blank","title":"Service Unavailable","status":503,"detail":"The dashboard is temporarily unavailable."}';
    }
    location / {
        proxy_pass http://unix:{{SOCKET}};
        proxy_http_version 1.1;
        proxy_set_header Host {{DOMAIN}};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-GetBible-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
        proxy_set_header Proxy "";
        proxy_set_header Connection "";
        proxy_cache off;
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_read_timeout 75s;
        proxy_connect_timeout 5s;
    }
}
