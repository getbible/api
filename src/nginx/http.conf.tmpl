# getBible API - http-context definitions shared by every endpoint.
# Managed by getbible.sh; hand edits are detected and reported on update.
#
# Only things that cannot live in a server block belong here: the JSON log
# format and the maps that identify a caller. Zones and caches are rendered
# per endpoint into conf.d/getbible-ep-<slug>.conf.

log_format getbible_json escape=json '{'
    '"time":"$time_iso8601",'
    '"host":"$host",'
    '"endpoint":"$server_name",'
    '"version":"$gb_version",'
    '"remote_addr":"$remote_addr",'
    '"method":"$request_method",'
    '"uri":"$request_uri",'
    '"status":$status,'
    '"bytes":$body_bytes_sent,'
    '"request_length":$request_length,'
    '"request_time":$request_time,'
    '"upstream_time":"$upstream_response_time",'
    '"cache":"$upstream_cache_status",'
    '"referer":"$http_referer",'
    '"user_agent":"$http_user_agent",'
    '"resolved_endpoint_kind":"$upstream_http_x_getbible_telemetry_endpoint_kind",'
    '"resolved_version":"$upstream_http_x_getbible_telemetry_version",'
    '"resolved_operation":"$upstream_http_x_getbible_telemetry_operation",'
    '"resolved_translation":"$upstream_http_x_getbible_telemetry_translation",'
    '"resolved_books":"$upstream_http_x_getbible_telemetry_books",'
    '"request_id":"$request_id",'
    '"token":"$gb_token_id",'
    '"auth_state":"$gb_auth_state",'
    '"scheme":"$gb_public_scheme",'
    '"protocol":"$server_protocol",'
    '"tls":"$ssl_protocol",'
    '"country":"$http_cf_ipcountry"'
'}';

# Token map keys are long ("<host> Bearer <token>"); size the hash for them.
map_hash_bucket_size 256;
map_hash_max_size 8192;

# The public scheme is configured by the operator in external TLS mode.
# Never derive it from a caller-controlled X-Forwarded-Proto header.
map $host $gb_public_scheme {
    default {{PUBLIC_SCHEME}};
}

# API version segment of the request, for logs and analytics.
map $uri $gb_version {
    default "";
    "~^/(?<gbv>v[0-9]+)(/|$)" $gbv;
}

# Caller identity from a bearer token. Every endpoint renders its own token
# map into getbible/tokens/<slug>.map as: "<server_name> Bearer <token>" "<id>";
map "$server_name $http_authorization" $gb_token_candidate {
    default "";
    include {{NGINX_GB_DIR}}/tokens/*.map;
}

# Validate lifetime for every request against epoch seconds, independent of
# worker reloads and the server's local timezone. Expired callers immediately
# lose both protected access and the metered-mode quota exemption.
map "$server_name $gb_token_candidate $msec" $gb_token_id {
    volatile;
    default "";
    include {{NGINX_GB_DIR}}/token-validity/*.map;
}

# Log credential presence and validity without ever logging the credential.
map $http_authorization $gb_authorization_present {
    "" 0;
    default 1;
}
map "$gb_token_id:$gb_authorization_present" $gb_auth_state {
    ":0" anonymous;
    ":1" rejected;
    default valid;
}

# Limits key on the client address and are switched off for token holders:
# an empty key means "not limited" to the limit_req and limit_conn modules.
map $gb_token_id $gb_limit_key {
    "" $binary_remote_addr;
    default "";
}
