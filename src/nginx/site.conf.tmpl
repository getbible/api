# getBible API - {{DOMAIN}} ({{TYPE}}{{#IF KIND}}/{{KIND}}{{/IF}}), rendered by getbible.sh.
# Hand edits are detected on update and never silently overwritten.

{{#UNLESS EXTERNAL_TLS}}server {
    listen {{HTTP_PORT}};
{{#IF IPV6}}    listen [::]:{{HTTP_PORT}};
{{/IF}}    server_name {{DOMAIN}};

    include snippets/getbible/acme.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}
{{/UNLESS}}{{#IF SERVING}}
server {
{{#IF EXTERNAL_TLS}}    listen {{HTTP_PORT}};
{{#IF IPV6}}    listen [::]:{{HTTP_PORT}};
{{/IF}}    server_name {{DOMAIN}};
    # TLS terminates at the trusted reverse proxy. Relative redirects keep
    # nginx's internal HTTP scheme and published Docker port out of Location.
    absolute_redirect off;
    include snippets/getbible/external-proxy.conf;
{{/IF}}{{#IF TLS}}
    listen 443 ssl{{#IF HTTP2_LEGACY}} http2{{/IF}};
{{#IF IPV6}}    listen [::]:443 ssl{{#IF HTTP2_LEGACY}} http2{{/IF}};
{{/IF}}{{#IF HTTP2_NATIVE}}    http2 on;
{{/IF}}    server_name {{DOMAIN}};

    ssl_certificate     {{CERT_DIR}}/fullchain.pem;
    ssl_certificate_key {{CERT_DIR}}/privkey.pem;
    include snippets/getbible/tls.conf;
{{/IF}}
{{#IF ORIGIN_PULLS}}
    # Only Cloudflare holds a client certificate signed by this CA.
    ssl_client_certificate {{NGINX_GB_DIR}}/cloudflare-origin-pull-ca.pem;
    ssl_verify_client on;
{{/IF}}{{#IF REAL_IP}}
    include {{NGINX_GB_DIR}}/cloudflare-real-ip.conf;
{{/IF}}
    access_log {{LOG_DIR}}/access.log getbible_json buffer=64k flush=1s;
    error_log  {{LOG_DIR}}/error.log warn;

    # Also answer origin-identity challenges after an HTTP-to-HTTPS redirect.
    include snippets/getbible/acme.conf;
    include snippets/getbible/origin-probe.conf;
    include {{NGINX_GB_DIR}}/{{DOMAIN}}/server.conf;
    include snippets/getbible/headers.conf;
    include snippets/getbible/errors.conf;
    include {{NGINX_GB_DIR}}/{{DOMAIN}}/limits.conf;

    # Preflights are answered here, cheaply and without authentication.
    if ($request_method = OPTIONS) {
        return 204;
    }
{{#IF MCP_ENABLED}}    # Only the MCP route adds POST to a static domain's method contract.
    set $getbible_method_path "$request_method:$uri";
    if ($getbible_method_path !~ ^(({{METHODS_REGEX}}):.*|POST:/mcp)$) {
        return 405;
    }
{{/IF}}{{#UNLESS MCP_ENABLED}}    if ($request_method !~ ^({{METHODS_REGEX}})$) {
        return 405;
    }
{{/UNLESS}}
{{#IF REJECT_ARGS}}
    # Nothing on this domain accepts parameters.
    if ($args != "") {
        return 400;
    }
{{/IF}}
{{#IF DOMAIN_PAGE}}
    # The domain page, or the root endpoint's page when there are no version folders.
    location = / {
        root {{DOMAIN_PAGE_ROOT}};
        open_file_cache off;
        types { }
        default_type text/html;
        try_files {{DOMAIN_PAGE_FILE}} =404;
        include snippets/getbible/headers-html.conf;
    }
{{/IF}}{{#IF FAVICON}}
    location = /favicon.ico {
        root {{WWW_DIR}};
        types { }
        default_type {{FAVICON_MIME}};
        try_files /favicon.ico =404;
        include snippets/getbible/headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
    }
{{/IF}}{{#IF IMG}}
    # The images the pages link: the logo, the icon at their foot, the touch
    # icon and the link-preview image, each with its own media type.
    location ^~ /img/ {
        root {{WWW_DIR}};

        location ~ ^/img/[A-Za-z0-9][A-Za-z0-9._-]*\.(png|jpe?g|svg|gif|webp|ico)$ {
            types {
                image/png                 png;
                image/jpeg                jpg jpeg;
                image/svg+xml             svg;
                image/gif                 gif;
                image/webp                webp;
                image/vnd.microsoft.icon  ico;
            }
            default_type application/octet-stream;
            try_files $uri =404;
            include snippets/getbible/headers.conf;
            add_header Cache-Control "public, max-age=86400" always;
        }
        return 404;
    }
{{/IF}}{{#IF VERSIONS_JSON}}
    location = /versions.json {
        root {{WWW_DIR}};
        try_files /versions.json =404;
        include snippets/getbible/headers.conf;
        add_header Cache-Control "public, max-age=300" always;
    }
    # Compatibility spelling: both addresses serve the same generated index.
    location = /version.json {
        root {{WWW_DIR}};
        try_files /versions.json =404;
        include snippets/getbible/headers.conf;
        add_header Cache-Control "public, max-age=300" always;
    }
{{/IF}}{{#IF DOMAIN_OPENAPI}}
    location = /openapi.json {
        root {{DOMAIN_OPENAPI_ROOT}};
        open_file_cache off;
        types { }
        default_type application/json;
        try_files {{DOMAIN_OPENAPI_FILE}} =404;
        include snippets/getbible/headers.conf;
        add_header Cache-Control "public, max-age=300" always;
    }
{{/IF}}
{{LOCATIONS}}
    location ~ /\. {
        access_log off;
        log_not_found off;
        return 404;
    }
}
{{/IF}}
