[Unit]
Requires=getbible-prepare.service
After=getbible-prepare.service
Description=getBible managed storage accounting
After=local-fs.target
OnFailure=getbible-alert@%n.service
# Successful oneshot starts count toward systemd's rate limit too. The timer
# already waits 30 seconds after completion, and manual refreshes must remain
# available. There is no automatic Restart loop for this bounded sampler.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group={{READERS_GROUP}}
EnvironmentFile={{RUN}}/storage.env
ExecStart={{PYTHON}} {{LIBEXEC}}/getbible-storage-guard sample --config {{ETC}}/getbible.conf --environment {{RUN}}/storage.env --state {{VAR}}/storage
UMask=0027
# This sampler is independent of long-running deployment/adaptation jobs.
# It reads inode metadata only and exits immediately when the budget is off.
Nice=19
IOSchedulingClass=idle
CPUQuota=50%
MemoryHigh=256M
MemoryMax=512M
TasksMax=16
TimeoutStartSec=75
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths={{VAR}}/storage
