[Unit]
Description=getBible MCP ({{DOMAIN}})
After=network-online.target {{UNIT}}.socket
Wants=network-online.target
Requires={{UNIT}}.socket
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
User=getbible-mcp
Group=getbible-mcp
WorkingDirectory={{RELEASE}}
Environment=PYTHONUNBUFFERED=1
Environment=GETBIBLE_MCP_PUBLIC_BASE=https://{{DOMAIN}}
Environment=GETBIBLE_MCP_ALLOWED_HOSTS={{DOMAIN}},localhost,127.0.0.1
Environment=GETBIBLE_MCP_ALLOWED_ORIGINS=https://{{DOMAIN}}
Environment=GETBIBLE_MCP_ORIGIN={{ORIGIN}}
{{#IF EXTRA_ENV}}EnvironmentFile={{EXTRA_ENV}}
{{/IF}}ExecStartPre={{RELEASE}}/.venv/bin/python -m getbible_mcp_api.check
ExecStart={{RELEASE}}/.venv/bin/gunicorn --config {{GENERATION}}/gunicorn.conf.py getbible_mcp_api.app:create_app()
KillSignal=SIGTERM
TimeoutStartSec=60
TimeoutStopSec=60
Restart=on-failure
RestartSec=3
UMask=0027
MemoryHigh=224M
MemoryMax=256M
CPUQuota=100%
TasksMax=64
LimitNOFILE=4096
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/dev/shm
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{UNIT}}

[Install]
WantedBy=multi-user.target
