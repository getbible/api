[Unit]
Description=getBible apply the current container image to existing endpoints
Requires=getbible-prepare.service
After=local-fs.target nginx.service getbible-prepare.service
Wants=nginx.service
OnFailure=getbible-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
ExecStart={{MANAGER}} image-update --yes
# Existing API generations keep serving while replacements become ready.
# A large installation must not be interrupted halfway through its domains.
TimeoutStartSec=infinity
TimeoutStopSec=300
KillMode=mixed
PrivateTmp=true

[Install]
WantedBy=multi-user.target
