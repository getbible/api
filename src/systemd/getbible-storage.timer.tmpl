[Unit]
Description=Keep getBible storage admission accounting current

[Timer]
OnBootSec=10s
# Resume unfinished accounting without discarding completed scan work.
# Complete snapshots carry a freshness window derived from the bounded whole
# scan horizon, this 30-second interval and scheduling allowance.
OnUnitInactiveSec=30s
AccuracySec=1s
Unit=getbible-storage.service

[Install]
WantedBy=timers.target
