[Unit]
Requires=getbible-prepare.service
After=getbible-prepare.service
Description=getBible traffic journal and health collector
After=local-fs.target nginx.service
OnFailure=getbible-alert@%n.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=getbible-dashboard
UMask=0027
EnvironmentFile={{RUN}}/telemetry.env
ExecStart={{PYTHON}} {{LIBEXEC}}/getbible-telemetry collect --db {{VAR}}/telemetry/traffic.sqlite3 --log-root {{LOG}} --settings {{RUN}}/telemetry.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths={{VAR}}/telemetry {{LOG}}
LimitNOFILE=4096
TasksMax=32
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
