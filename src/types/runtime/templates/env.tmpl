# Environment of the getBible {{KIND}} service for {{DOMAIN}} {{LABEL}}, rendered by getbible.sh.
# Edit through `getbible.sh` (the endpoint's settings); direct edits are overwritten on update.
GETBIBLE_REPOSITORY={{REPOSITORY}}
GETBIBLE_VERSION={{VERSION}}
GETBIBLE_CACHE_DIR={{CACHE_DIR}}
GETBIBLE_CACHE_TTL_SECONDS={{CACHE_TTL_SECONDS}}
GETBIBLE_REQUIRE_CHECKSUMS={{REQUIRE_CHECKSUMS}}
GETBIBLE_STRICT_FRESHNESS=false
GB_ACCESS_MODE={{ACCESS_MODE}}
GETBIBLE_APP_LOG={{APP_LOG}}
{{ENV_PREFIX}}_DEFAULT_TRANSLATION={{DEFAULT_TRANSLATION}}
{{ENV_PREFIX}}_ALLOWED_TRANSLATIONS={{ALLOWED_TRANSLATIONS}}
{{ENV_PREFIX}}_TRUST_PROXY=true
{{ENV_PREFIX}}_LOG_LEVEL=INFO
{{ENV_PREFIX}}_CACHE_SECONDS={{CACHE_SECONDS}}
{{ENV_PREFIX}}_WORKERS={{WORKERS}}
{{ENV_PREFIX}}_THREADS={{THREADS}}
{{ENV_PREFIX}}_WARM_TRANSLATIONS={{WARM_TRANSLATIONS}}
{{ENV_PREFIX}}_BIND=unix:{{SOCKET}}
{{#IF IS_QUERY}}QUERY_DEFAULT_REFERENCE={{DEFAULT_REFERENCE}}
{{/IF}}{{#IF IS_SEARCH}}SEARCH_MAX_CONCURRENT={{THREADS}}
SEARCH_MAX_CONCURRENT_EXPENSIVE={{EXPENSIVE_CONCURRENT}}
{{/IF}}{{EXTRA_ENV}}
