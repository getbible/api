    # Health and everything not claimed above go to the default endpoint's
    # service: the short forms of a domain with version folders, or the whole
    # tree of a domain that serves its endpoint at the root.
    location = /healthz {
        access_log off;
        include snippets/getbible/proxy.conf;
        proxy_pass http://unix:{{SOCKET}}:;
    }

    location = /readyz {
        access_log off;
        include snippets/getbible/proxy.conf;
        proxy_pass http://unix:{{SOCKET}}:;
    }
{{#IF ROOT_ENDPOINT}}{{#IF ROOT_DOCS_FILE}}
    # The page at /. A request that carries a query string or a body is the
    # service's; it is handed over through an internal-only prefix so the
    # root rewrite below does not apply to it twice.
    location = / {
        if ($args != "") { rewrite ^ /.gb/{{APP_VERSION}} last; }
        if ($request_method !~ ^(GET|HEAD)$) { rewrite ^ /.gb/{{APP_VERSION}} last; }
        root {{ROOT_DOCS_ROOT}};
        types { }
        default_type text/html;
        try_files {{ROOT_DOCS_FILE}} =404;
        include snippets/getbible/headers-html.conf;
    }

    location ^~ /.gb/ {
        internal;
        rewrite ^/\.gb(/.*)$ $1 break;
        proxy_redirect ~^(https?://[^/]+)?/{{APP_VERSION}}(/.*)$ $1$2;
        proxy_redirect ~^(https?://[^/]+)?/{{APP_VERSION}}$ $1/;
{{PROXY_BODY}}
    }
{{/IF}}
    # The service speaks /{{APP_VERSION}}/...; this domain serves it at its root.
    location / {
        rewrite ^/(.*)$ /{{APP_VERSION}}/$1 break;
        proxy_redirect ~^(https?://[^/]+)?/{{APP_VERSION}}(/.*)$ $1$2;
        proxy_redirect ~^(https?://[^/]+)?/{{APP_VERSION}}$ $1/;
{{PROXY_BODY}}
    }
{{/IF}}{{#UNLESS ROOT_ENDPOINT}}
    location / {
{{PROXY_BODY}}
    }
{{/UNLESS}}
