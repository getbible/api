    # Health and everything not claimed above go to the default endpoint's
    # service: the short forms of a domain with version folders, or the whole
    # tree of a domain that serves its endpoint at the root.
    location = /healthz {
        access_log off;
        include snippets/getbible/proxy.conf;
        proxy_pass http://unix:{{SOCKET}}:;
    }

    location = /readyz {
        access_log off;
        include snippets/getbible/proxy.conf;
        proxy_pass http://unix:{{SOCKET}}:;
    }
{{#IF ROOT_ENDPOINT}}{{#IF ROOT_DOCS_FILE}}
    # The page at /. A request that carries a query string or a body is the
    # service's; it is handed over through an internal-only prefix that
    # clients cannot reach.
    location = / {
        if ($args != "") { rewrite ^ /.gb/service last; }
        if ($request_method !~ ^(GET|HEAD)$) { rewrite ^ /.gb/service last; }
        root {{ROOT_DOCS_ROOT}};
        types { }
        default_type text/html;
        try_files {{ROOT_DOCS_FILE}} =404;
        include snippets/getbible/headers-html.conf;
    }

    location ^~ /.gb/ {
        internal;
        proxy_redirect ~^(https?://[^/]+)?/{{APP_VERSION}}(/.*)$ $1$2;
        proxy_redirect ~^(https?://[^/]+)?/{{APP_VERSION}}$ $1/;
{{PROXY_BODY}}
    }
{{/IF}}
    # The service speaks /{{APP_VERSION}}/...; this domain serves it at its
    # root: proxy_pass prepends the version to the request URI as the client
    # sent it (no rewrite, so the access rules above it still run), and the
    # service's redirects lose the version again on the way out.
    location / {
        proxy_redirect ~^(https?://[^/]+)?/{{APP_VERSION}}(/.*)$ $1$2;
        proxy_redirect ~^(https?://[^/]+)?/{{APP_VERSION}}$ $1/;
{{PROXY_BODY}}
    }
{{/IF}}{{#UNLESS ROOT_ENDPOINT}}
    location / {
{{PROXY_BODY}}
    }
{{/UNLESS}}
