{{#UNLESS IS_ROOT}}    # {{DOMAIN}} endpoint {{LABEL}}: its page and OpenAPI document, served by
    # exact locations whatever file types the tree allows.
    location = /{{LABEL}} {
        return 301 {{PREFIX}};
    }
{{#IF DOCS_FILE}}
    location = {{PREFIX}} {
        root {{DOCS_ROOT}};
        open_file_cache off;
        types { }
        default_type text/html;
        try_files {{DOCS_FILE}} =404;
        include snippets/getbible/headers-html.conf;
    }
{{/IF}}{{#IF OPENAPI_FILE}}
    location = {{PREFIX}}openapi.json {
        root {{OPENAPI_ROOT}};
        open_file_cache off;
        types { }
        default_type application/json;
        try_files {{OPENAPI_FILE}} =404;
        include snippets/getbible/headers.conf;
        add_header Cache-Control "public, max-age=300" always;
    }
{{/IF}}
{{/UNLESS}}{{#UNLESS OPENAPI_FILE}}    # Reserve a disabled specification address even when the tree contains JSON.
    location = {{PREFIX}}openapi.json {
        return 404;
    }
{{/UNLESS}}    # {{DOMAIN}} endpoint {{LABEL}}: {{TREE_ROOT}}{{PREFIX}} -> current release
    location ^~ {{PREFIX}} {
        root {{TREE_ROOT}};
        # Resolve the current-release symlink for each new request. Cached
        # descriptors would keep independently serving files from the old tree
        # after an atomic publication; the kernel still caches file contents.
        open_file_cache off;

        location ~ /\. {
            access_log off;
            log_not_found off;
            return 404;
        }
{{#IF DATA_EXT_REGEX}}
        location ~* ^{{PREFIX}}.+\.({{DATA_EXT_REGEX}})$ {
            include {{NGINX_GB_DIR}}/{{DOMAIN}}/auth.conf;
            try_files $uri =404;
            include snippets/getbible/headers.conf;
{{#IF TOKEN_ACCESS}}            add_header Cache-Control "private, no-store" always;
            add_header Vary "Authorization" always;
{{/IF}}{{#UNLESS TOKEN_ACCESS}}            add_header Cache-Control "public, max-age={{CACHE_TTL}}, stale-while-revalidate=86400, stale-if-error=86400" always;
{{/UNLESS}}
        }
{{/IF}}{{#IF HAS_SHA}}
        location ~* ^{{PREFIX}}.+\.sha$ {
            include {{NGINX_GB_DIR}}/{{DOMAIN}}/auth.conf;
            try_files $uri =404;
            include snippets/getbible/headers.conf;
{{#IF TOKEN_ACCESS}}            add_header Cache-Control "private, no-store" always;
            add_header Vary "Authorization" always;
{{/IF}}{{#UNLESS TOKEN_ACCESS}}            add_header Cache-Control "public, max-age={{SHA_CACHE_TTL}}, stale-while-revalidate=3600, stale-if-error=86400" always;
{{/UNLESS}}
        }
{{/IF}}{{#IF HAS_HTML}}
        location ~* ^{{PREFIX}}.+\.html$ {
            include {{NGINX_GB_DIR}}/{{DOMAIN}}/auth.conf;
            try_files $uri =404;
{{#IF TOKEN_ACCESS}}            include snippets/getbible/headers-html-private.conf;
            add_header Vary "Authorization" always;
{{/IF}}{{#UNLESS TOKEN_ACCESS}}            include snippets/getbible/headers-html.conf;
{{/UNLESS}}
        }
{{/IF}}
        return 404;
    }
