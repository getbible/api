    # {{DOMAIN}} version {{LABEL}}: {{DATA_DIR}}/{{LABEL}} -> current release
    location ^~ /{{LABEL}}/ {
        root {{DATA_DIR}};
        # Resolve the current-release symlink for each new request. Cached
        # descriptors would keep independently serving files from the old tree
        # after an atomic publication; the kernel still caches file contents.
        open_file_cache off;

        location ~ /\. {
            access_log off;
            log_not_found off;
            return 404;
        }
{{#IF DATA_EXT_REGEX}}
        location ~* ^/{{LABEL}}/.+\.({{DATA_EXT_REGEX}})$ {
            include {{NGINX_GB_DIR}}/{{DOMAIN}}/auth.conf;
            try_files $uri =404;
            include snippets/getbible/headers.conf;
{{#IF TOKEN_ACCESS}}            add_header Cache-Control "private, no-store" always;
            add_header Vary "Authorization" always;
{{/IF}}{{#UNLESS TOKEN_ACCESS}}            add_header Cache-Control "public, max-age={{CACHE_TTL}}, stale-while-revalidate=86400, stale-if-error=86400" always;
{{/UNLESS}}
        }
{{/IF}}{{#IF HAS_SHA}}
        location ~* ^/{{LABEL}}/.+\.sha$ {
            include {{NGINX_GB_DIR}}/{{DOMAIN}}/auth.conf;
            try_files $uri =404;
            include snippets/getbible/headers.conf;
{{#IF TOKEN_ACCESS}}            add_header Cache-Control "private, no-store" always;
            add_header Vary "Authorization" always;
{{/IF}}{{#UNLESS TOKEN_ACCESS}}            add_header Cache-Control "public, max-age={{SHA_CACHE_TTL}}, stale-while-revalidate=3600, stale-if-error=86400" always;
{{/UNLESS}}
        }
{{/IF}}{{#IF HAS_HTML}}
        location ~* ^/{{LABEL}}/.+\.html$ {
            include {{NGINX_GB_DIR}}/{{DOMAIN}}/auth.conf;
            try_files $uri =404;
{{#IF TOKEN_ACCESS}}            include snippets/getbible/headers-html-private.conf;
            add_header Vary "Authorization" always;
{{/IF}}{{#UNLESS TOKEN_ACCESS}}            include snippets/getbible/headers-html.conf;
{{/UNLESS}}
        }
{{/IF}}
        return 404;
    }
