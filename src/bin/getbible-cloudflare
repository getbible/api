#!/usr/bin/env python3
"""Cloudflare integration for getBible endpoints (standard library only).

Usage:
  getbible-cloudflare verify
  getbible-cloudflare zone DOMAIN
  getbible-cloudflare dns-show DOMAIN
  getbible-cloudflare dns DOMAIN --proxied true|false [--ipv4 A] [--ipv6 AAAA]
  getbible-cloudflare host-rules DOMAIN --cache bypass|respect [--security api|default]
  getbible-cloudflare host-rules-remove DOMAIN
  getbible-cloudflare protect-access DOMAIN
  getbible-cloudflare zone-settings DOMAIN [--http3 on] [--brotli on] [--min-tls 1.2] [--always-https on]
  getbible-cloudflare bot-fight DOMAIN on|off
  getbible-cloudflare origin-pulls DOMAIN on|off
  getbible-cloudflare ips
  getbible-cloudflare origin-ca

The API token comes from the CLOUDFLARE_API_TOKEN environment variable. Every
command prints JSON on stdout (prefix the command with --human for menu-style
output) and exits non-zero with a message on stderr on failure. Rules created here carry the description "getbible:<domain>" so
they are updated in place and never duplicate.
"""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request

API = "https://api.cloudflare.com/client/v4"
IPS_V4 = "https://www.cloudflare.com/ips-v4"
IPS_V6 = "https://www.cloudflare.com/ips-v6"
ORIGIN_CA = "https://developers.cloudflare.com/ssl/static/authenticated_origin_pull_ca.pem"


class CloudflareError(SystemExit):
    pass


def request(method: str, path: str, body: dict | list | None = None) -> dict:
    token = os.environ.get("CLOUDFLARE_API_TOKEN", "")
    if not token:
        raise CloudflareError("CLOUDFLARE_API_TOKEN is not set")
    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request(API + path, data=data, method=method)
    req.add_header("Authorization", f"Bearer {token}")
    req.add_header("Content-Type", "application/json")
    req.add_header("User-Agent", "getbible-api/1.0")
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        text = error.read().decode("utf-8", "replace")
        try:
            payload = json.loads(text)
        except ValueError:
            raise CloudflareError(f"Cloudflare {method} {path}: HTTP {error.code}: {text[:300]}") from error
        if error.code == 404 and method == "GET":
            return {"success": False, "result": None, "errors": payload.get("errors", []), "status": 404}
        messages = "; ".join(f"{e.get('code')}: {e.get('message')}" for e in payload.get("errors", [])) or text[:300]
        raise CloudflareError(f"Cloudflare {method} {path}: {messages}") from error
    except urllib.error.URLError as error:
        raise CloudflareError(f"Cloudflare unreachable: {error.reason}") from error
    if not payload.get("success", False):
        messages = "; ".join(f"{e.get('code')}: {e.get('message')}" for e in payload.get("errors", []))
        raise CloudflareError(f"Cloudflare {method} {path}: {messages or 'request failed'}")
    return payload


def fetch_text(url: str) -> str:
    req = urllib.request.Request(url, headers={"User-Agent": "getbible-api/1.0"})
    with urllib.request.urlopen(req, timeout=30) as response:
        return response.read().decode("utf-8")


def find_zone(domain: str) -> dict:
    labels = domain.split(".")
    for index in range(len(labels) - 1):
        candidate = ".".join(labels[index:])
        payload = request("GET", f"/zones?name={candidate}&status=active&per_page=5")
        for zone in payload.get("result") or []:
            if zone.get("name") == candidate:
                return zone
    raise CloudflareError(f"no active Cloudflare zone contains {domain}")


def dns_records(zone_id: str, domain: str) -> list[dict]:
    payload = request("GET", f"/zones/{zone_id}/dns_records?name={domain}&per_page=50")
    return payload.get("result") or []


def cmd_dns(domain: str, args: list[str]) -> dict:
    proxied = None
    ipv4 = ipv6 = None
    while args:
        item = args.pop(0)
        if item == "--proxied":
            proxied = args.pop(0).lower() in {"true", "on", "yes", "1"}
        elif item == "--ipv4":
            ipv4 = args.pop(0)
        elif item == "--ipv6":
            ipv6 = args.pop(0)
        else:
            raise CloudflareError(f"unknown option {item}")
    zone = find_zone(domain)
    existing = {(r["type"]): r for r in dns_records(zone["id"], domain) if r["type"] in {"A", "AAAA"}}
    if not existing and not ipv4 and not ipv6:
        raise CloudflareError(f"No A/AAAA records or origin addresses are available for {domain}; DNS was not configured")
    results = []
    for record_type, content in (("A", ipv4), ("AAAA", ipv6)):
        current = existing.get(record_type)
        if content is None:
            if current is not None and proxied is not None and current.get("proxied") != proxied:
                body = {"type": record_type, "name": domain, "content": current["content"], "proxied": proxied, "ttl": 1}
                results.append(request("PATCH", f"/zones/{zone['id']}/dns_records/{current['id']}", body)["result"])
            continue
        body = {"type": record_type, "name": domain, "content": content, "proxied": bool(proxied), "ttl": 1,
                "comment": "managed by getbible.sh"}
        if current is None:
            results.append(request("POST", f"/zones/{zone['id']}/dns_records", body)["result"])
        elif current.get("content") != content or current.get("proxied") != bool(proxied):
            results.append(request("PATCH", f"/zones/{zone['id']}/dns_records/{current['id']}", body)["result"])
        else:
            results.append(current)
    return {"zone": zone["name"], "records": [{"type": r["type"], "content": r["content"], "proxied": r["proxied"]} for r in results]}


def cmd_dns_show(domain: str) -> dict:
    zone = find_zone(domain)
    return {"zone": zone["name"], "records": [{"type": r["type"], "content": r["content"], "proxied": r.get("proxied")}
                                             for r in dns_records(zone["id"], domain)]}


def entrypoint(zone_id: str, phase: str) -> dict | None:
    payload = request("GET", f"/zones/{zone_id}/rulesets/phases/{phase}/entrypoint")
    return payload.get("result")


def replace_rule(zone_id: str, phase: str, description: str, rule: dict | None,
                 *, first: bool = False, last: bool = False) -> dict:
    """Change only this host's managed rule, never replace a shared ruleset.

    Keep an existing rule in its current position unless first is requested
    for the API exception before challenges, or last for cache/config overrides.
    The single-rule endpoints
    also preserve unrelated rules changed after our GET. Exact descriptions
    identify the rules created by this tool across subsequent updates.
    """
    current = entrypoint(zone_id, phase)
    wanted = dict(rule, description=description) if rule is not None else None
    if current is None:
        if wanted is None:
            return {}
        try:
            # POST creates a new entry point; unlike PUT it cannot overwrite
            # an entry point another administrator creates after our GET.
            return request("POST", f"/zones/{zone_id}/rulesets", {
                "name": f"getBible {phase}", "kind": "zone", "phase": phase,
                "rules": [wanted],
            })["result"]
        except CloudflareError:
            # Another writer may have created it, or our successful POST may
            # have lost its response. Re-read and update only our rule.
            current = entrypoint(zone_id, phase)
            if current is None:
                raise

    owned = [r for r in current.get("rules", []) if r.get("description") == description]
    if wanted is None and not owned:
        return current
    ruleset_id = current.get("id")
    if not ruleset_id or any(not item.get("id") for item in owned):
        raise CloudflareError(f"Cloudflare returned a rule without an ID in {phase}")
    path = f"/zones/{zone_id}/rulesets/{ruleset_id}/rules"
    result = current
    if wanted is not None:
        if first:
            wanted["position"] = {"index": 1}
        elif last:
            wanted["position"] = {"after": ""}
        if not owned:
            return request("POST", path, wanted)["result"]
        existing = owned.pop(0)
        if existing.get("ref"):
            wanted["ref"] = existing["ref"]
        result = request("PATCH", f"{path}/{existing['id']}", wanted)["result"]
    # Remove only exact managed matches (including any historical duplicates).
    for existing in owned:
        result = request("DELETE", f"{path}/{existing['id']}")["result"]
    return result


def api_bot_settings(zone_id: str, domain: str) -> dict:
    """Read the non-skippable prerequisite without changing other hosts."""
    try:
        settings = request("GET", f"/zones/{zone_id}/bot_management").get("result")
    except CloudflareError as error:
        raise CloudflareError(
            f"Cannot verify Bot Fight Mode for {domain}; the API profile was not applied. "
            f"The token needs Bot Management Read permission: {error}"
        ) from error
    if not isinstance(settings, dict):
        raise CloudflareError(f"Cloudflare did not return bot settings for {domain}")
    stale = settings.get("stale_zone_configuration") or {}
    if settings.get("fight_mode") or stale.get("fight_mode"):
        raise CloudflareError(
            f"Bot Fight Mode is enabled for the zone containing {domain}; it can challenge API clients "
            "and cannot be skipped per hostname. Keep DNS-only mode, or explicitly disable it with "
            f"'getbible.sh cloudflare bot-fight {domain} off' (affects the whole zone), then retry."
        )
    return settings


# The two expressions are complements within one hostname, so our cache and
# bypass rules never override one another, regardless of their positions.
# Query-bearing requests stay at the origin: shared cache-key rules may drop
# parameters, and a full custom query-key override requires Enterprise.
PUBLIC_CACHE_REQUEST = (
    '(http.request.method in {"GET" "HEAD"} '
    'and http.request.uri.query eq "" '
    'and not any(http.request.headers["authorization"][*] ne "") '
    'and http.cookie eq "" and not http.request.headers.truncated)'
)


def cmd_host_rules(domain: str, args: list[str]) -> dict:
    cache = "bypass"
    security = "api"
    while args:
        item = args.pop(0)
        if item == "--cache":
            cache = args.pop(0)
        elif item == "--security":
            security = args.pop(0)
        else:
            raise CloudflareError(f"unknown option {item}")
    if cache not in {"bypass", "respect"} or security not in {"api", "default"}:
        raise CloudflareError("cache must be bypass|respect and security must be api|default")
    zone = find_zone(domain)
    expression = f'(http.host eq "{domain}")'
    description = f"getbible:{domain}"
    out: dict = {"zone": zone["name"]}
    bot_settings = api_bot_settings(zone["id"], domain) if security == "api" else {}

    # Configuration rule: API-friendly security for this host only.
    if security == "api":
        config = {
            "action": "set_config", "expression": expression, "enabled": True,
            "action_parameters": {"bic": False, "security_level": "essentially_off", "ssl": "strict",
                                  "automatic_https_rewrites": False, "opportunistic_encryption": False},
        }
    else:
        config = None
    out["config_rule"] = "set" if config else "removed"
    replace_rule(zone["id"], "http_config_settings", description, config, last=True)

    # Cache eligibility applies to every endpoint on the hostname, including
    # JSON. Credentials and POSTs must also bypass reads of a public cache hit.
    if cache == "respect":
        private_rule = {
            "action": "set_cache_settings",
            "expression": f"{expression} and not {PUBLIC_CACHE_REQUEST}", "enabled": True,
            "action_parameters": {"cache": False},
        }
        replace_rule(zone["id"], "http_request_cache_settings", description + ":private", private_rule, last=True)
        cache_rule = {
            "action": "set_cache_settings",
            "expression": f"{expression} and {PUBLIC_CACHE_REQUEST}", "enabled": True,
            "action_parameters": {"cache": True, "edge_ttl": {"mode": "bypass_by_default"},
                                  "browser_ttl": {"mode": "respect_origin"},
                                  "respect_strong_etags": True, "origin_error_page_passthru": True},
        }
    else:
        cache_rule = {"action": "set_cache_settings", "expression": expression, "enabled": True,
                      "action_parameters": {"cache": False}}
    out["cache_rule"] = cache
    if cache == "respect":
        out["query_string_requests"] = "bypass edge cache; origin keeps complete URL cache keys"
    replace_rule(zone["id"], "http_request_cache_settings", description, cache_rule, last=True)
    if cache == "bypass":
        # The host-wide bypass is already active before the narrower rule goes.
        replace_rule(zone["id"], "http_request_cache_settings", description + ":private", None)

    # An exception appended after a custom challenge is too late. Place only
    # our host-scoped rule first, preserving other rules and their relative order.
    phases = ["http_ratelimit", "http_request_firewall_managed"]
    if any(key.startswith("sbfm_") for key in bot_settings) or any(
            key.startswith("sbfm_") for key in (bot_settings.get("stale_zone_configuration") or {})):
        phases.append("http_request_sbfm")
    skip = {
        "action": "skip", "expression": expression, "enabled": True,
        "action_parameters": {"ruleset": "current", "phases": phases,
                              "products": ["bic", "hot", "securityLevel", "uaBlock", "zoneLockdown"]},
        "logging": {"enabled": True},
    }
    replace_rule(zone["id"], "http_request_firewall_custom", description,
                 skip if security == "api" else None, first=security == "api")
    out["waf_skip"] = "set" if security == "api" else "removed"
    if security == "api":
        out["bot_fight_mode"] = "off"
    return out


def cmd_protect_access(domain: str) -> dict:
    """Stop shared caching before evicting formerly public content for a host.

    This deliberately never falls back to purging the entire zone: other
    applications can share it. Missing Cache Purge permission is an error.
    """
    zone = find_zone(domain)
    rule = {
        "action": "set_cache_settings", "expression": f'(http.host eq "{domain}")', "enabled": True,
        "action_parameters": {"cache": False},
    }
    replace_rule(zone["id"], "http_request_cache_settings", f"getbible:{domain}", rule, last=True)
    request("POST", f"/zones/{zone['id']}/purge_cache", {"hosts": [domain]})
    return {"zone": zone["name"], "host": domain, "cache": "bypass", "purged": True}


def cmd_host_rules_remove(domain: str) -> dict:
    zone = find_zone(domain)
    description = f"getbible:{domain}"
    errors = []
    for phase, owned_description in (
        ("http_config_settings", description), ("http_request_cache_settings", description),
        ("http_request_cache_settings", description + ":private"), ("http_request_firewall_custom", description),
    ):
        try:
            replace_rule(zone["id"], phase, owned_description, None)
        except CloudflareError as error:
            errors.append(f"{phase}: {error}")
    if errors:
        raise CloudflareError("Could not remove all host rules: " + "; ".join(errors))
    return {"zone": zone["name"], "removed": description}


def cmd_zone_settings(domain: str, args: list[str]) -> dict:
    zone = find_zone(domain)
    wanted = {}
    while args:
        item = args.pop(0)
        value = args.pop(0)
        key = {"--http3": "http3", "--brotli": "brotli", "--min-tls": "min_tls_version", "--always-https": "always_use_https",
               "--tls13": "tls_1_3", "--ssl": "ssl"}.get(item)
        if key is None:
            raise CloudflareError(f"unknown option {item}")
        wanted[key] = value
    out = {"zone": zone["name"], "settings": {}}
    for key, value in wanted.items():
        try:
            request("PATCH", f"/zones/{zone['id']}/settings/{key}", {"value": value})
            out["settings"][key] = value
        except SystemExit as error:
            out["settings"][key] = f"not applied ({error})"
    return out


def cmd_bot_fight(domain: str, state: str) -> dict:
    zone = find_zone(domain)
    enabled = state.lower() in {"on", "true", "yes"}
    request("PUT", f"/zones/{zone['id']}/bot_management", {"fight_mode": enabled})
    return {"zone": zone["name"], "fight_mode": enabled}


def cmd_origin_pulls(domain: str, state: str) -> dict:
    zone = find_zone(domain)
    enabled = state.lower() in {"on", "true", "yes"}
    # nginx trusts Cloudflare's shared global AOP certificate. The separate
    # origin_tls_client_auth/settings endpoint enables uploaded custom
    # certificates and does not enable this shared-certificate mode.
    request("PATCH", f"/zones/{zone['id']}/settings/tls_client_auth", {"value": "on" if enabled else "off"})
    return {"zone": zone["name"], "authenticated_origin_pulls": enabled}


def cmd_ips() -> dict:
    v4 = [line.strip() for line in fetch_text(IPS_V4).splitlines() if line.strip()]
    v6 = [line.strip() for line in fetch_text(IPS_V6).splitlines() if line.strip()]
    if not v4 or not v6:
        raise CloudflareError("Cloudflare returned an empty address list")
    return {"ipv4": v4, "ipv6": v6}


def human_report(out: dict) -> str:
    """Readable menu output; the command-line default remains JSON."""
    lines = []

    def value_text(value):
        if isinstance(value, bool):
            return "yes" if value else "no"
        return str(value) if value is not None else "-"

    def field(key, value, indent=""):
        label = key.replace("_", " ").capitalize()
        if isinstance(value, dict):
            lines.append(f"{indent}{label}")
            for child_key, child in value.items():
                field(child_key, child, indent + "  ")
        elif isinstance(value, list):
            lines.append(f"{indent}{label}: " + ("" if value else "none"))
            for child in value:
                lines.append(f"{indent}  {value_text(child)}")
        else:
            lines.append(f"{indent}{label:<24} {value_text(value)}")

    for key, value in out.items():
        if key != "records":
            field(key, value)
    if "records" in out:
        lines.extend(["", "DNS records", f"  {'Type':<7} {'Routing':<18} Address / value"])
        for record in out["records"]:
            proxied = record.get("proxied")
            routing = "Cloudflare proxy" if proxied is True else "Direct / DNS only" if proxied is False else "-"
            lines.append(f"  {record['type']:<7} {routing:<18} {record['content']}")
        if not out["records"]:
            lines.append("  No records.")
    return "\n".join(lines)


def main(argv: list[str]) -> int:
    human = len(argv) > 1 and argv[1] == "--human"
    if human:
        argv = [argv[0], *argv[2:]]
    if len(argv) < 2 or argv[1] in {"-h", "--help"}:
        sys.stderr.write(__doc__)
        return 2
    command, rest = argv[1], argv[2:]
    if command == "verify":
        result = request("GET", "/user/tokens/verify")["result"]
        out = {"status": result.get("status"), "id": result.get("id")}
    elif command == "zone":
        zone = find_zone(rest[0])
        out = {"id": zone["id"], "name": zone["name"], "plan": (zone.get("plan") or {}).get("name")}
    elif command == "dns-show":
        out = cmd_dns_show(rest[0])
    elif command == "dns":
        out = cmd_dns(rest[0], rest[1:])
    elif command == "host-rules":
        out = cmd_host_rules(rest[0], rest[1:])
    elif command == "host-rules-remove":
        out = cmd_host_rules_remove(rest[0])
    elif command == "protect-access":
        out = cmd_protect_access(rest[0])
    elif command == "zone-settings":
        out = cmd_zone_settings(rest[0], rest[1:])
    elif command == "bot-fight":
        out = cmd_bot_fight(rest[0], rest[1])
    elif command == "origin-pulls":
        out = cmd_origin_pulls(rest[0], rest[1])
    elif command == "ips":
        out = cmd_ips()
    elif command == "origin-ca":
        print(fetch_text(ORIGIN_CA), end="")
        return 0
    else:
        raise CloudflareError(f"unknown command {command}")
    print(human_report(out) if human else json.dumps(out, indent=2))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except CloudflareError as error:
        sys.stderr.write(f"getbible-cloudflare: {error}\n")
        raise SystemExit(1)
