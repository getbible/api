#!/usr/bin/env python3
"""Traffic analytics from the getBible JSON access logs.

Usage: getbible-analytics --log-root DIR [--endpoint DOMAIN ...]
                          [--window today|24h|7d|30d|all] [--json] [--top N]

Reads every endpoint's live access log and its archived rotations whose
modification time falls inside the window, streams the JSON lines, and
reports per endpoint and combined:

  total calls      every request except CORS preflights (OPTIONS)
  unique callers   distinct token ids, or distinct client addresses when no
                   token was presented (IPv6 collapsed to its /64)
  status classes, rate-limited requests, bytes, latency percentiles, cache
  hits, top paths, versions, tokens and user agents.

Combined unique callers are the union across endpoints, so one client
that used two endpoints counts once. Nothing here prints a raw address.
"""

from __future__ import annotations

import argparse
import gzip
import hashlib
import ipaddress
import json
import os
import sys
import time
from collections import Counter
from datetime import datetime, timedelta, timezone

UTC = timezone.utc

WINDOWS = {"today": None, "24h": 24 * 3600, "7d": 7 * 86400, "30d": 30 * 86400, "all": None}


def caller_key(entry: dict) -> str:
    token = entry.get("token") or ""
    if token and token != "-":
        return "token:" + token
    address = entry.get("remote_addr") or "-"
    try:
        parsed = ipaddress.ip_address(address)
        if parsed.version == 6:
            address = str(ipaddress.ip_network(f"{parsed}/64", strict=False))
    except ValueError:
        pass
    return "ip:" + address


def compact(key: str) -> bytes:
    return hashlib.blake2b(key.encode("utf-8"), digest_size=12).digest()


def parse_time(value: str) -> float | None:
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except (ValueError, AttributeError):
        return None


def window_start(name: str, now: float) -> float:
    if name == "today":
        today = datetime.now(UTC).replace(hour=0, minute=0, second=0, microsecond=0)
        return today.timestamp()
    seconds = WINDOWS[name]
    return 0.0 if seconds is None else now - seconds


def percentile(values: list[float], fraction: float) -> float:
    if not values:
        return 0.0
    values = sorted(values)
    index = min(len(values) - 1, int(round(fraction * (len(values) - 1))))
    return values[index]


class Stats:
    def __init__(self) -> None:
        self.calls = 0
        self.preflights = 0
        self.callers: set[bytes] = set()
        self.ips: set[bytes] = set()
        self.tokens: Counter = Counter()
        self.status: Counter = Counter()
        self.limited = 0
        self.bytes = 0
        self.times: list[float] = []
        self.cache_hits = 0
        self.cache_total = 0
        self.paths: Counter = Counter()
        self.versions: Counter = Counter()
        self.agents: Counter = Counter()
        self.days: Counter = Counter()
        self.malformed = 0
        self.first: float | None = None
        self.last: float | None = None

    def add(self, entry: dict, stamp: float) -> None:
        if entry.get("method") == "OPTIONS":
            self.preflights += 1
            return
        self.calls += 1
        key = caller_key(entry)
        self.callers.add(compact(key))
        if key.startswith("token:"):
            self.tokens[key[6:]] += 1
        else:
            self.ips.add(compact(key))
        try:
            status = int(entry.get("status", 0))
        except (TypeError, ValueError):
            status = 0
        self.status[f"{status // 100}xx" if status else "0"] += 1
        if status == 429:
            self.limited += 1
        try:
            self.bytes += int(entry.get("bytes", 0) or 0)
        except (TypeError, ValueError):
            pass
        try:
            duration = float(entry.get("request_time", 0) or 0)
            if len(self.times) < 200_000:
                self.times.append(duration)
        except (TypeError, ValueError):
            pass
        cache = entry.get("cache") or ""
        if cache and cache not in ("-", ""):
            self.cache_total += 1
            if cache == "HIT":
                self.cache_hits += 1
        uri = str(entry.get("uri") or "")
        self.paths[uri.split("?", 1)[0][:120]] += 1
        self.versions[entry.get("version") or "-"] += 1
        self.agents[str(entry.get("user_agent") or "-")[:80]] += 1
        self.days[datetime.fromtimestamp(stamp, UTC).strftime("%Y-%m-%d")] += 1
        self.first = stamp if self.first is None or stamp < self.first else self.first
        self.last = stamp if self.last is None or stamp > self.last else self.last

    def merge(self, other: "Stats") -> None:
        self.calls += other.calls
        self.preflights += other.preflights
        self.callers |= other.callers
        self.ips |= other.ips
        self.tokens.update(other.tokens)
        self.status.update(other.status)
        self.limited += other.limited
        self.bytes += other.bytes
        self.times.extend(other.times[: max(0, 200_000 - len(self.times))])
        self.cache_hits += other.cache_hits
        self.cache_total += other.cache_total
        self.paths.update(other.paths)
        self.versions.update(other.versions)
        self.agents.update(other.agents)
        self.days.update(other.days)
        self.malformed += other.malformed
        for stamp in (other.first, other.last):
            if stamp is None:
                continue
            self.first = stamp if self.first is None or stamp < self.first else self.first
            self.last = stamp if self.last is None or stamp > self.last else self.last

    def summary(self, top: int) -> dict:
        return {
            "total_calls": self.calls,
            "preflights": self.preflights,
            "unique_callers": len(self.callers),
            "unique_addresses": len(self.ips),
            "unique_tokens": len(self.tokens),
            "status": dict(sorted(self.status.items())),
            "rate_limited": self.limited,
            "bytes_sent": self.bytes,
            "latency_seconds": {
                "p50": round(percentile(self.times, 0.50), 4),
                "p95": round(percentile(self.times, 0.95), 4),
                "p99": round(percentile(self.times, 0.99), 4),
            },
            "cache_hit_ratio": round(self.cache_hits / self.cache_total, 3) if self.cache_total else None,
            "top_paths": self.paths.most_common(top),
            "versions": dict(self.versions.most_common(top)),
            "tokens": dict(self.tokens.most_common(top)),
            "top_user_agents": self.agents.most_common(top),
            "calls_per_day": dict(sorted(self.days.items())),
            "malformed_lines": self.malformed,
            "first_seen": datetime.fromtimestamp(self.first, UTC).isoformat() if self.first else None,
            "last_seen": datetime.fromtimestamp(self.last, UTC).isoformat() if self.last else None,
        }


def log_files(directory: str, start: float) -> list[str]:
    files = []
    live = os.path.join(directory, "access.log")
    if os.path.isfile(live):
        files.append(live)
    archive = os.path.join(directory, "archive")
    if os.path.isdir(archive):
        for name in sorted(os.listdir(archive)):
            if not name.startswith("access.log"):
                continue
            path = os.path.join(archive, name)
            try:
                if os.path.getmtime(path) >= start:
                    files.append(path)
            except OSError:
                continue
    return files


def read_lines(path: str):
    opener = gzip.open if path.endswith(".gz") else open
    try:
        with opener(path, "rt", encoding="utf-8", errors="replace") as handle:
            yield from handle
    except OSError:
        return


def analyse(directory: str, start: float, end: float) -> Stats:
    stats = Stats()
    for path in log_files(directory, start):
        for line in read_lines(path):
            line = line.strip()
            if not line:
                continue
            try:
                entry = json.loads(line)
            except ValueError:
                stats.malformed += 1
                continue
            stamp = parse_time(str(entry.get("time", "")))
            if stamp is None:
                stats.malformed += 1
                continue
            if stamp < start or stamp > end:
                continue
            stats.add(entry, stamp)
    return stats


def fmt_int(value: int) -> str:
    return f"{value:,}"


def render_text(report: dict, top: int) -> str:
    lines = [f"getBible traffic — window: {report['window']} ({report['from']} to {report['to']})", ""]
    for name, data in report["endpoints"].items():
        lines.append(f"== {name} ==")
        lines.append(f"  calls: {fmt_int(data['total_calls'])}   unique callers: {fmt_int(data['unique_callers'])}"
                     f"   (addresses {fmt_int(data['unique_addresses'])}, tokens {fmt_int(data['unique_tokens'])})   preflights: {fmt_int(data['preflights'])}")
        status = ", ".join(f"{k} {fmt_int(v)}" for k, v in data["status"].items()) or "-"
        lines.append(f"  status: {status}   rate limited: {fmt_int(data['rate_limited'])}   bytes: {fmt_int(data['bytes_sent'])}")
        lat = data["latency_seconds"]
        cache = f"{data['cache_hit_ratio']:.0%}" if data["cache_hit_ratio"] is not None else "n/a"
        lines.append(f"  latency p50/p95/p99: {lat['p50']}/{lat['p95']}/{lat['p99']}s   proxy cache hits: {cache}")
        if data["versions"]:
            lines.append("  versions: " + ", ".join(f"{k} {fmt_int(v)}" for k, v in data["versions"].items()))
        if data["tokens"]:
            lines.append("  tokens: " + ", ".join(f"{k} {fmt_int(v)}" for k, v in data["tokens"].items()))
        for path, count in data["top_paths"][:top]:
            lines.append(f"    {fmt_int(count):>10}  {path}")
        if data["malformed_lines"]:
            lines.append(f"  malformed lines skipped: {data['malformed_lines']}")
        lines.append("")
    combined = report["combined"]
    lines.append("== all endpoints ==")
    lines.append(f"  calls: {fmt_int(combined['total_calls'])}   unique callers (union): {fmt_int(combined['unique_callers'])}"
                 f"   (addresses {fmt_int(combined['unique_addresses'])}, tokens {fmt_int(combined['unique_tokens'])})")
    status = ", ".join(f"{k} {fmt_int(v)}" for k, v in combined["status"].items()) or "-"
    lines.append(f"  status: {status}   rate limited: {fmt_int(combined['rate_limited'])}   bytes: {fmt_int(combined['bytes_sent'])}")
    if combined["calls_per_day"]:
        lines.append("  per day: " + ", ".join(f"{k} {fmt_int(v)}" for k, v in list(combined["calls_per_day"].items())[-14:]))
    return "\n".join(lines)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--log-root", required=True)
    parser.add_argument("--endpoint", action="append", default=[])
    parser.add_argument("--window", choices=sorted(WINDOWS), default="24h")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--top", type=int, default=10)
    args = parser.parse_args(argv[1:])

    now = time.time()
    start = window_start(args.window, now)
    endpoints = args.endpoint or sorted(
        name for name in os.listdir(args.log_root)
        if os.path.isdir(os.path.join(args.log_root, name)) and os.path.exists(os.path.join(args.log_root, name, "access.log"))
    ) if os.path.isdir(args.log_root) else []
    combined = Stats()
    report = {
        "window": args.window,
        "from": datetime.fromtimestamp(start, UTC).isoformat() if start else "beginning",
        "to": datetime.fromtimestamp(now, UTC).isoformat(),
        "endpoints": {},
    }
    for name in endpoints:
        stats = analyse(os.path.join(args.log_root, name), start, now)
        report["endpoints"][name] = stats.summary(args.top)
        combined.merge(stats)
    report["combined"] = combined.summary(args.top)
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(render_text(report, args.top))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
