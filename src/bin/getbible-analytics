#!/usr/bin/env python3
"""Origin analytics from the canonical, continuously collected SQLite history.

No archive scans run when a dashboard or CLI report opens. Counts and latency
queries include every retained origin request in the selected time range.
"""

from __future__ import annotations

import argparse
import ipaddress
import json
import os
import sqlite3
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

_base = Path(__file__).resolve().parent
for _package in (_base / "apps" / "telemetry", _base.parent / "apps" / "telemetry"):
    if _package.is_dir():
        sys.path.insert(0, str(_package))
        break
from getbible_telemetry import TelemetryStore

UTC = timezone.utc

WINDOWS = {"today": None, "24h": 24 * 3600, "7d": 7 * 86400, "30d": 30 * 86400, "all": None}


def caller_key(entry: dict) -> str:
    token = entry.get("token") or ""
    if token and token != "-":
        return "token:" + token
    address = entry.get("remote_addr") or "-"
    try:
        parsed = ipaddress.ip_address(address)
        if parsed.version == 6:
            address = str(ipaddress.ip_network(f"{parsed}/64", strict=False))
    except ValueError:
        pass
    return "ip:" + address






def window_start(name: str, now: float) -> float:
    if name == "today":
        today = datetime.now(UTC).replace(hour=0, minute=0, second=0, microsecond=0)
        return today.timestamp()
    seconds = WINDOWS[name]
    return 0.0 if seconds is None else now - seconds












def fmt_int(value: int) -> str:
    return f"{value:,}"


def render_text(report: dict, top: int) -> str:
    lines = [f"getBible traffic — window: {report['window']} ({report['from']} to {report['to']})", ""]
    for name, data in report["endpoints"].items():
        lines.append(f"== {name} ==")
        lines.append(f"  calls: {fmt_int(data['total_calls'])}   unique callers: {fmt_int(data['unique_callers'])}"
                     f"   (addresses {fmt_int(data['unique_addresses'])}, tokens {fmt_int(data['unique_tokens'])})   preflights: {fmt_int(data['preflights'])}")
        status = ", ".join(f"{k} {fmt_int(v)}" for k, v in data["status"].items()) or "-"
        lines.append(f"  status: {status}   rate limited: {fmt_int(data['rate_limited'])}   bytes: {fmt_int(data['bytes_sent'])}")
        lat = data["latency_seconds"]
        cache = f"{data['cache_hit_ratio']:.0%}" if data["cache_hit_ratio"] is not None else "n/a"
        lines.append(f"  latency p50/p95/p99: {lat['p50']}/{lat['p95']}/{lat['p99']}s   proxy cache hits: {cache}")
        if data["versions"]:
            lines.append("  versions: " + ", ".join(f"{k} {fmt_int(v)}" for k, v in data["versions"].items()))
        if data["tokens"]:
            lines.append("  tokens: " + ", ".join(f"{k} {fmt_int(v)}" for k, v in data["tokens"].items()))
        for path, count in data["top_paths"][:top]:
            lines.append(f"    {fmt_int(count):>10}  {path}")
        if data["malformed_lines"]:
            lines.append(f"  malformed lines skipped: {data['malformed_lines']}")
        lines.append("")
    combined = report["combined"]
    lines.append("== all endpoints ==")
    lines.append(f"  calls: {fmt_int(combined['total_calls'])}   unique callers (union): {fmt_int(combined['unique_callers'])}"
                 f"   (addresses {fmt_int(combined['unique_addresses'])}, tokens {fmt_int(combined['unique_tokens'])})")
    status = ", ".join(f"{k} {fmt_int(v)}" for k, v in combined["status"].items()) or "-"
    lines.append(f"  status: {status}   rate limited: {fmt_int(combined['rate_limited'])}   bytes: {fmt_int(combined['bytes_sent'])}")
    if combined["calls_per_day"]:
        lines.append("  per day: " + ", ".join(f"{k} {fmt_int(v)}" for k, v in list(combined["calls_per_day"].items())[-14:]))
    return "\n".join(lines)


def database_summary(store: TelemetryStore, start: float, end: float, domains: list[str], top: int) -> dict:
    """Aggregate in SQLite, including every retained request in the range."""
    store.db.create_function("caller_key", 2, lambda token, address: caller_key({"token": token, "remote_addr": address}), deterministic=True)
    where = "stamp>=? AND stamp<? AND edge_json IS NOT NULL"
    values = [start, end]
    if domains:
        where += " AND endpoint IN (" + ",".join("?" for _ in domains) + ")"
        values.extend(domains)
    store._deadline()
    preflights = store.db.execute("SELECT count(*) FROM requests WHERE method='OPTIONS' AND " + where, values).fetchone()[0]
    where += " AND method!='OPTIONS'"
    row = store.db.execute(
        "SELECT count(*) AS total_calls,count(DISTINCT caller_key(token_id,remote_addr)) AS unique_callers, "
        "count(DISTINCT CASE WHEN token_id='' THEN caller_key('',remote_addr) END) AS unique_addresses, "
        "count(DISTINCT NULLIF(token_id,'')) AS unique_tokens,COALESCE(sum(status=429),0) AS rate_limited,"
        "COALESCE(sum(bytes),0) AS bytes_sent,COALESCE(sum(cache='HIT'),0) AS cache_hits,"
        "COALESCE(sum(cache NOT IN ('','-')),0) AS cache_total,min(stamp) AS first_seen,max(stamp) AS last_seen "
        "FROM requests WHERE " + where, values).fetchone()
    result = dict(row)
    result["preflights"] = preflights
    def counts(expression: str, *, extra: str = "", limited: bool = True) -> list:
        query = "SELECT " + expression + ",count(*) AS n FROM requests WHERE " + where + extra + " GROUP BY 1 ORDER BY n DESC,1"
        return [list(item) for item in store.db.execute(query + (" LIMIT ?" if limited else ""), [*values, top] if limited else values)]
    result["status"] = dict(counts("CAST(status / 100 AS INTEGER) || 'xx'"))
    result["top_paths"] = counts("path")
    result["versions"] = dict(counts("version"))
    result["tokens"] = dict(counts("token_id", extra=" AND token_id!=''"))
    result["top_user_agents"] = counts("user_agent")
    result["calls_per_day"] = dict(sorted(counts("strftime('%Y-%m-%d',stamp,'unixepoch')", limited=False)))
    hits = result.pop("cache_hits")
    total = result.pop("cache_total")
    result["cache_hit_ratio"] = hits / total if total else None
    count = result["total_calls"]
    result["latency_seconds"] = {}
    for name, fraction in (("p50", .5), ("p95", .95), ("p99", .99)):
        offset = min(max(0, count-1), round(fraction * max(0, count-1)))
        value = store.db.execute("SELECT duration_ms FROM requests WHERE " + where + " ORDER BY duration_ms LIMIT 1 OFFSET ?",
                                 [*values, offset]).fetchone() if count else None
        result["latency_seconds"][name] = round(value[0] / 1000, 4) if value else 0
    event_where = "stamp>=? AND stamp<? AND json_extract(payload,'$.malformed')=1"
    event_values = [start, end]
    if domains:
        event_where += " AND endpoint IN (" + ",".join("?" for _ in domains) + ")"
        event_values.extend(domains)
    result["malformed_lines"] = store.db.execute("SELECT count(*) FROM events WHERE " + event_where, event_values).fetchone()[0]
    for key in ("first_seen", "last_seen"):
        result[key] = datetime.fromtimestamp(result[key], UTC).isoformat() if result[key] is not None else None
    return result


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--log-root", help="Compatibility option; history is read from --db")
    parser.add_argument("--db", default=os.environ.get("GETBIBLE_TELEMETRY_DB", "/var/lib/getbible/telemetry/traffic.sqlite3"))
    parser.add_argument("--endpoint", action="append", default=[])
    parser.add_argument("--window", choices=sorted(WINDOWS), default="24h")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--top", type=int, default=10)
    args = parser.parse_args(argv[1:])

    now = time.time()
    start = window_start(args.window, now)
    report = {
        "window": args.window,
        "from": datetime.fromtimestamp(start, UTC).isoformat() if start else "beginning",
        "to": datetime.fromtimestamp(now, UTC).isoformat(),
        "endpoints": {},
    }
    try:
        with TelemetryStore(args.db, readonly=True) as store:
            endpoints = args.endpoint or sorted({item["endpoint"] for item in store.endpoints()})
            args.top = max(1, min(args.top, 1000))
            for name in endpoints:
                report["endpoints"][name] = database_summary(store, start, now, [name], args.top)
            report["combined"] = database_summary(store, start, now, args.endpoint, args.top)
            report["history"] = store.storage()
            report["origin_only"] = True
    except sqlite3.Error as exc:
        print("Telemetry history unavailable: " + str(exc) + ". Check getbible-telemetry.service.", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(render_text(report, args.top))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
