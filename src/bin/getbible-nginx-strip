#!/usr/bin/env python3
"""Remove the server blocks that declare given server names from an nginx
configuration file, writing the result to stdout.

Usage: getbible-nginx-strip FILE DOMAIN [DOMAIN ...]

Only top-level `server { ... }` blocks whose server_name directive lists one
of the domains are removed; everything else is kept byte for byte. Exit
status 3 when nothing matched.
"""

from __future__ import annotations

import re
import sys

_SERVER_NAME = re.compile(r"^\s*server_name\s+([^;]+);", re.MULTILINE)


def blocks(text: str):
    """Yield (start, end) of top-level server blocks, comment-aware enough."""
    index = 0
    length = len(text)
    while index < length:
        match = re.compile(r"(?m)^\s*server\s*\{").search(text, index)
        if match is None:
            return
        depth = 0
        pos = match.end() - 1
        in_comment = False
        while pos < length:
            char = text[pos]
            if in_comment:
                if char == "\n":
                    in_comment = False
            elif char == "#":
                in_comment = True
            elif char == "{":
                depth += 1
            elif char == "}":
                depth -= 1
                if depth == 0:
                    end = pos + 1
                    while end < length and text[end] in " \t":
                        end += 1
                    if end < length and text[end] == "\n":
                        end += 1
                    yield match.start(), end
                    index = end
                    break
            pos += 1
        else:
            return


def main(argv: list[str]) -> int:
    if len(argv) < 3:
        sys.stderr.write(__doc__)
        return 2
    path, domains = argv[1], set(argv[2:])
    with open(path, encoding="utf-8") as handle:
        text = handle.read()
    output = []
    last = 0
    removed = 0
    for start, end in list(blocks(text)):
        block = text[start:end]
        names = set()
        for match in _SERVER_NAME.finditer(block):
            names.update(match.group(1).split())
        if names & domains:
            output.append(text[last:start])
            last = end
            removed += 1
    output.append(text[last:])
    sys.stdout.write("".join(output))
    return 0 if removed else 3


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
