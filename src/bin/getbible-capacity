#!/usr/bin/env python3
"""Inspect effective limits, collection health and evidence-based capacity advice."""
import argparse
import json
from pathlib import Path
import sys

base = Path(__file__).resolve().parent
for path in (base / "apps" / "telemetry", base.parent / "apps" / "telemetry"):
    if path.is_dir():
        sys.path.insert(0, str(path))
        break
from getbible_telemetry.diagnostics import format_capacity, read_capacity


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--db", default="/var/lib/getbible/telemetry/traffic.sqlite3")
    parser.add_argument("--config", default="/etc/getbible/getbible.conf")
    parser.add_argument("--environment", default="/var/lib/getbible/environment.conf")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    report = read_capacity(args.db, args.config, args.environment)
    print(json.dumps(report, ensure_ascii=False, indent=2) if args.json else format_capacity(report))


if __name__ == "__main__":
    main()
