MAX_REQUEST = 2 * 1024 * 1024
MAX_OUTPUT = 256 * 1024
REFRESH_RETRY_DELAYS = (1, 5)
REFRESH_COMMAND = ("/usr/bin/systemctl", "--no-block", "restart", "getbible-admin.service")


class ManagementPaused(Exception):
    """Accepted work is draining before a management service refresh."""

DOMAIN = r"[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?)+"
RUNTIME_KEYS = "WORKERS|THREADS|WARM_TRANSLATIONS|DEFAULT_TRANSLATION|DEFAULT_REFERENCE|ALLOWED_TRANSLATIONS|REPOSITORY|CACHE_TTL|MEMORY_CACHE_TTL|MEMORY_MIN|MEMORY_MAX|CPU_QUOTA|WORKERS_MIN|WORKERS_MAX|THREADS_MIN|THREADS_MAX|CACHE_MEMORY_PERCENT|SHARED_CORPUS_LIMIT|CHAPTER_CACHE_LIMIT|TRANSLATION_CACHE_LIMIT|REFERENCE_CACHE_LIMIT"
PATTERNS = {
    "domain": DOMAIN, "endpoint": r"(?:v[0-9]+|root)",
    "key": r"[A-Z][A-Z0-9_]*", "translation": r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}",
    "translations": r"[A-Za-z0-9][A-Za-z0-9_, -]{0,4095}",
    "date": r"[0-9]{4}-[0-9]{2}-[0-9]{2}", "id": r"[A-Za-z0-9_-]{1,128}",
    "integer": r"[0-9]{1,12}", "path": r"(?:/|[A-Za-z0-9])[A-Za-z0-9_./ -]{0,4095}",
}


def field(name, kind="text", *, required=True, choices=None, default=None, secret=False, label=None, allow_empty=False):
    result = {"name": name, "type": kind, "required": required, "label": label or name.replace("_", " ").title()}
    if choices is not None:
        result["choices"] = choices.split("|") if isinstance(choices, str) else choices
    if default is not None:
        result["default"] = default
    if secret:
        result["secret"] = True
    if allow_empty:
        result["allow_empty"] = True
    return result


D = field("domain", "domain")
E = field("endpoint", "endpoint")
EO = field("endpoint", "endpoint", required=False)
OPS = {}


def operation(name, title, command, fields=(), *, category="Domains", mutates=True, destructive=False, secret_output=False, description=None, domain_types=None):
    OPS[name] = {"id": name, "name": name, "title": title, "category": category,
                 "fields": list(fields), "mutates": mutates, "destructive": destructive,
                 "secret_output": secret_output, "_command": command}
    if description:
        OPS[name]["description"] = description
    if domain_types is not None:
        OPS[name]["domain_types"] = list(domain_types)


