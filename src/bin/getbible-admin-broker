#!/usr/bin/env python3
"""Local, authenticated management jobs. This service never evaluates a shell.

The dashboard may submit a named operation and its typed arguments. The root
broker translates them to the same validated manager commands used by the CLI.
Jobs outlive dashboard viewers; running jobs interrupted by a broker restart are
reported as interrupted and are never silently replayed.
"""
from __future__ import annotations

import argparse
import base64
