#!/usr/bin/env python3
"""Verify a static release before publication: reject symlinks and unsafe or
malformed manifests, validate every JSON document, check sibling SHA-1 files
and hashes.json manifests. Files without checksum metadata are permitted.

Usage: getbible-verify-tree ROOT
"""

from __future__ import annotations

import hashlib
import json
import os
import re
import sys


def digest(path: str, algorithm: str) -> str:
    hasher = hashlib.new(algorithm)
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            hasher.update(block)
    return hasher.hexdigest()


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        sys.stderr.write(__doc__ or "")
        return 2
    root = os.path.abspath(argv[1])
    if not os.path.isdir(root) or os.path.islink(root):
        sys.stderr.write(f"not a regular directory: {root}\n")
        return 2

    problems: list[str] = []
    files = sha_checked = manifest_checked = 0

    def problem(message: str, path: str) -> None:
        problems.append(f"{message}: {os.path.relpath(path, root)}")

    def safe_file(path: str) -> bool:
        # A manifest may name a path through a symlink in a parent directory.
        return (os.path.commonpath((root, os.path.realpath(path))) == root
                and not os.path.islink(path) and os.path.isfile(path))

    def walk_error(error: OSError) -> None:
        problems.append(f"unreadable directory: {error.filename}")

    for directory, dirnames, filenames in os.walk(root, onerror=walk_error):
        dirnames.sort()
        for name in dirnames[:]:
            path = os.path.join(directory, name)
            if os.path.islink(path):
                problem("symlinks are forbidden", path)
                dirnames.remove(name)
        for name in sorted(filenames):
            files += 1
            path = os.path.join(directory, name)
            if not safe_file(path):
                problem("not a safe regular file", path)
                continue
            try:
                if name.endswith(".sha"):
                    sibling = os.path.join(directory, name[:-4] + ".json")
                    if not safe_file(sibling):
                        problem("checksum has no safe JSON sibling", path)
                        continue
                    with open(path, encoding="ascii") as handle:
                        expected = handle.read(1024).strip().lower()
                    if re.fullmatch(r"[0-9a-f]{40}", expected) is None:
                        problem("invalid checksum text", path)
                        continue
                    if digest(sibling, "sha1") != expected:
                        problem("sha1 mismatch", sibling)
                    sha_checked += 1
                if not name.endswith(".json"):
                    continue
                with open(path, encoding="utf-8") as handle:
                    document = json.load(handle)
                if name != "hashes.json":
                    continue
                if not isinstance(document, dict):
                    problem("unsupported manifest", path)
                    continue
                algorithm = document.get("algorithm")
                if isinstance(algorithm, str):
                    algorithm = algorithm.lower()
                listed = document.get("files")
                if algorithm not in {"sha1", "sha256", "sha384", "sha512"} or not isinstance(listed, dict) or not listed:
                    problem("unsupported or empty manifest", path)
                    continue
                length = hashlib.new(algorithm).digest_size * 2
                for relative, expected in sorted(listed.items()):
                    if not relative or ".." in relative.split("/") or relative.startswith("/") or "\\" in relative:
                        problems.append(f"unsafe manifest path: {relative}")
                        continue
                    target = os.path.join(directory, relative)
                    if not safe_file(target):
                        problem("missing or unsafe manifest target", target)
                        continue
                    if not isinstance(expected, str) or re.fullmatch(rf"[0-9a-fA-F]{{{length}}}", expected) is None:
                        problem("invalid manifest digest", target)
                        continue
                    if digest(target, algorithm) != expected.lower():
                        problem(f"{algorithm} mismatch", target)
                    manifest_checked += 1
            except (OSError, UnicodeError, ValueError, TypeError):
                problem("unreadable or malformed file", path)

    print(json.dumps({"root": root, "files": files, "sha_checked": sha_checked,
                      "manifest_checked": manifest_checked, "problems": len(problems)}))
    for message in problems[:50]:
        sys.stderr.write(message + "\n")
    if len(problems) > 50:
        sys.stderr.write(f"... and {len(problems) - 50} more\n")
    return 1 if problems else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
