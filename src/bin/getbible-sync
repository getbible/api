#!/usr/bin/env bash
# Export a trusted repository to a unique release while the old release remains
# live, then publish through one atomic rename. No nginx reload is required.
set -Eeuo pipefail
IFS=$'\n\t'
umask 027

: "${GB_SYNC_DOMAIN:?}" "${GB_SYNC_VERSION:?}" "${GB_SYNC_REPO:?}" "${GB_SYNC_REF:?}"
: "${GB_SYNC_HOME:?}" "${GB_SYNC_DATA:?}"
GB_SYNC_SUBPATH="${GB_SYNC_SUBPATH:-.}"
GB_SYNC_EXTENSIONS="${GB_SYNC_EXTENSIONS:-json,sha,txt}"
# Files exported by path whatever their type: the endpoint's documentation
# page and OpenAPI document when they come from the repository.
GB_SYNC_EXTRA_FILES="${GB_SYNC_EXTRA_FILES:-}"
GB_SYNC_KEEP="${GB_SYNC_KEEP:-2}"
GB_SYNC_FORCE="${GB_SYNC_FORCE:-0}"
GB_NOTIFY="${GB_NOTIFY:-/usr/local/lib/getbible/getbible-notify}"
GB_EXPORT="${GB_EXPORT:-/usr/local/lib/getbible/getbible-export-tree}"

# "root" is the tree of a domain served without version folders.
[[ "$GB_SYNC_VERSION" =~ ^(v[1-9][0-9]*|root)$ ]] || { echo 'Invalid version label' >&2; exit 2; }
[[ "$GB_SYNC_KEEP" =~ ^[0-9]+$ ]] && (( GB_SYNC_KEEP >= 2 )) || { echo 'Keep at least two releases' >&2; exit 2; }
[[ "$GB_SYNC_SUBPATH" != /* && ! "$GB_SYNC_SUBPATH" =~ (^|/)\.\.(/|$) ]] || { echo 'Unsafe source path' >&2; exit 2; }
[[ "$GB_SYNC_REF" != -* && "$GB_SYNC_REF" != *$'\n'* && "$GB_SYNC_REF" != *$'\r'* ]] || { echo 'Invalid ref' >&2; exit 2; }

LABEL="$GB_SYNC_DOMAIN $GB_SYNC_VERSION"
CHECKOUT="$GB_SYNC_HOME/repos/$GB_SYNC_VERSION"
STATE_DIR="$GB_SYNC_HOME/state"
STATE="$STATE_DIR/$GB_SYNC_VERSION.conf"
LOCK="$GB_SYNC_HOME/lock-$GB_SYNC_VERSION"
FORCE_FILE="$STATE_DIR/$GB_SYNC_VERSION.force"
RELEASES="$GB_SYNC_DATA/releases/$GB_SYNC_VERSION"
CURRENT="$GB_SYNC_DATA/$GB_SYNC_VERSION"
STEP="start"
RELEASE=""
PUBLISHED=false
SWAP=""

log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
notify() { [[ -x "$GB_NOTIFY" ]] && "$GB_NOTIFY" "$@" || true; }
state_get() { local v=""; [[ -f "$STATE" ]] && v="$(grep -E "^$1=" "$STATE" | tail -1 | cut -d= -f2-)" || true; printf '%s' "$v"; }
state_set() {
    { [[ -f "$STATE" ]] && grep -vE "^$1=" "$STATE" || true; printf '%s=%s\n' "$1" "$2"; } > "$STATE.tmp"
    mv -f "$STATE.tmp" "$STATE"
}
cleanup() {
    [[ -z "$SWAP" ]] || rm -f -- "$SWAP"
    if [[ "$PUBLISHED" == false && -n "$RELEASE" ]]; then rm -rf -- "$RELEASE"; fi
}
on_error() {
    local code=$?
    log "FAILED during $STEP (exit $code)"
    notify fail "Sync failed: $LABEL" "Failed during: $STEP. Published release changed: $PUBLISHED. See the sync service journal."
    exit "$code"
}
trap on_error ERR
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mkdir -p "$GB_SYNC_HOME/repos" "$STATE_DIR" "$RELEASES"
exec 9>"$LOCK"
flock -n 9 || { log "another sync for $LABEL is running"; exit 0; }
[[ ! -e "$FORCE_FILE" ]] || GB_SYNC_FORCE=1
[[ -x "$GB_EXPORT" ]] || { log "required exporter missing or not executable: $GB_EXPORT"; false; }

export GIT_SSH_COMMAND="ssh -i $GB_SYNC_HOME/.ssh/id_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=$GB_SYNC_HOME/.ssh/known_hosts -o StrictHostKeyChecking=yes -o BatchMode=yes"
export GIT_TERMINAL_PROMPT=0
export HOME="$GB_SYNC_HOME"

# Resolve one exact branch or tag. Ambiguous short names must be qualified.
STEP="ls-remote"
log "checking $GB_SYNC_REPO ($GB_SYNC_REF) for $LABEL"
REFS="$(git ls-remote --heads --tags "$GB_SYNC_REPO")"
if [[ "$GB_SYNC_REF" == refs/heads/* || "$GB_SYNC_REF" == refs/tags/* ]]; then
    FETCH_REF="$GB_SYNC_REF"
elif [[ "$GB_SYNC_REF" == HEAD ]]; then
    FETCH_REF=HEAD
else
    git check-ref-format "refs/heads/$GB_SYNC_REF" >/dev/null || { log "invalid reference"; false; }
    BRANCH_SHA="$(awk -v ref="refs/heads/$GB_SYNC_REF" '$2 == ref {print $1}' <<< "$REFS")"
    TAG_SHA="$(awk -v ref="refs/tags/$GB_SYNC_REF" '$2 == ref {print $1}' <<< "$REFS")"
    [[ -z "$BRANCH_SHA" || -z "$TAG_SHA" ]] || { log 'branch and tag share this name; use refs/heads/... or refs/tags/...'; false; }
    if [[ -n "$BRANCH_SHA" ]]; then FETCH_REF="refs/heads/$GB_SYNC_REF"; else FETCH_REF="refs/tags/$GB_SYNC_REF"; fi
fi
if [[ "$FETCH_REF" == HEAD ]]; then
    REMOTE_SHA="$(git ls-remote "$GB_SYNC_REPO" HEAD | awk '$2 == "HEAD" {print $1}')"
else
    REMOTE_SHA="$(awk -v ref="$FETCH_REF" '$2 == ref {sha=$1} $2 == ref "^{}" {peeled=$1} END {print peeled ? peeled : sha}' <<< "$REFS")"
fi
[[ "$REMOTE_SHA" =~ ^[0-9a-f]{40,64}$ ]] || { log "reference $GB_SYNC_REF not found"; false; }
LAST_SHA="$(state_get LAST_SHA)"
# Repository/ref/export changes must be applied even when their commit matches.
CONFIG_SHA="$(printf '%s\0' "$GB_SYNC_REPO" "$FETCH_REF" "$GB_SYNC_SUBPATH" "$GB_SYNC_EXTENSIONS" "$GB_SYNC_EXTRA_FILES" | sha256sum | cut -d' ' -f1)"
if [[ "$REMOTE_SHA" == "$LAST_SHA" && "$(state_get CONFIG_SHA)" == "$CONFIG_SHA" && -L "$CURRENT" && -d "$CURRENT" && "$GB_SYNC_FORCE" != 1 ]]; then
    log "up to date at ${REMOTE_SHA:0:12}"
    state_set LAST_CHECK "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    exit 0
fi
notify start "Update started: $LABEL" "Repository: $GB_SYNC_REPO; reference: $FETCH_REF; commit: ${REMOTE_SHA:0:12}"

STEP="fetch"
if [[ ! -d "$CHECKOUT/.git" ]]; then
    rm -rf -- "$CHECKOUT"
    git init --quiet "$CHECKOUT"
    git -C "$CHECKOUT" remote add origin "$GB_SYNC_REPO"
else
    git -C "$CHECKOUT" remote set-url origin "$GB_SYNC_REPO"
fi
git -C "$CHECKOUT" fetch --quiet --depth 1 origin "$FETCH_REF"
HEAD_SHA="$(git -C "$CHECKOUT" rev-parse 'FETCH_HEAD^{commit}')"
# The fetch is authoritative if the branch advanced after ls-remote.
# Export Git's committed blobs directly: no checkout rewrite, JSON parsing,
# checksum verification or full-content comparison with the live release.

STEP="export"
RELEASE="$(mktemp -d "$RELEASES/$(date -u +%Y%m%dT%H%M%SZ)-${HEAD_SHA:0:12}-XXXXXXXX")"
chmod 0750 "$RELEASE"
PREVIOUS=""
[[ ! -L "$CURRENT" ]] || PREVIOUS="$(readlink -f "$CURRENT" || true)"
STATS="$("$GB_EXPORT" "$CHECKOUT" "$HEAD_SHA" "$GB_SYNC_SUBPATH" "$RELEASE" "$PREVIOUS" "$GB_SYNC_EXTENSIONS" "$GB_SYNC_EXTRA_FILES")"
IFS=$'\t' read -r FILES CHANGED <<< "$STATS"

printf '%s\n' "$HEAD_SHA" > "$RELEASE/.revision"
chmod 0640 "$RELEASE/.revision"

STEP="publish"
SWAP="$GB_SYNC_DATA/.$GB_SYNC_VERSION.$$.tmp"
ln -s "releases/$GB_SYNC_VERSION/$(basename "$RELEASE")" "$SWAP"
# rename(2) on the link itself; mv -T is not portable across coreutils here.
python3 -c 'import os, sys; os.rename(sys.argv[1], sys.argv[2])' "$SWAP" "$CURRENT"
SWAP=""
PUBLISHED=true

STEP="record"
KEEP_NAME="$(basename "$RELEASE")"
state_set LAST_SHA "$HEAD_SHA"
state_set CONFIG_SHA "$CONFIG_SHA"
state_set LAST_SYNC "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
state_set LAST_CHECK "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
state_set LAST_RELEASE "$KEEP_NAME"
state_set FILES "$FILES"
state_set CHANGED "$CHANGED"
rm -f "$FORCE_FILE"

STEP="prune"
# Retain the actual previous/current releases even for same-second updates.
# Older releases get an hour's grace to protect outstanding file opens.
KEPT=2
while read -r old; do
    [[ "$old" != "$KEEP_NAME" && "$RELEASES/$old" != "$PREVIOUS" ]] || continue
    if (( KEPT < GB_SYNC_KEEP )); then KEPT=$((KEPT + 1)); continue; fi
    if [[ -n "$(find "$RELEASES/$old" -maxdepth 0 -mmin +60 -print)" ]]; then
        rm -rf -- "${RELEASES:?}/$old"
        log "removed old release $old"
    fi
done < <(find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -r)

log "live: $LABEL at ${HEAD_SHA:0:12} ($FILES files, $CHANGED changed) -> $KEEP_NAME"
notify ok "Update live: $LABEL" "Commit: ${HEAD_SHA:0:12} ($FETCH_REF); files: $FILES; changed: $CHANGED; release: $KEEP_NAME"
