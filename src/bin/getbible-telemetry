#!/usr/bin/env python3
"""Run getBible telemetry from an installed manager or source checkout."""

import sys
from pathlib import Path

base = Path(__file__).resolve().parent
for path in (base / "apps" / "telemetry", base.parent / "apps" / "telemetry"):
    if path.is_dir():
        sys.path.insert(0, str(path))
        break

from getbible_telemetry.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
